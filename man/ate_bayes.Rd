  z = c(0, 0, 0, 0, 1, 1, 1, 1),
  a = c(0, 0, 1, 1, 0, 0, 1, 1),
  y = c(0, 1, 0, 1, 0, 1, 0, 1),
  n = c(158, 14, 0, 0, 52, 12, 23, 78)
))
set.seed(1)

# Sensitivity analysis: posterior of the ATE as a function of theta_N1
sens <- ate_bayes(lipid, y ~ a | z, theta_N1 = seq(0, 1, by = 0.05), n_draws = 1000)
